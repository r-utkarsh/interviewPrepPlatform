# FILE: .env.example
# WHAT IT DOES: Lists local environment variables with placeholders only.
# ROLE IN THE PROJECT: Gives Docker Compose and the backend a safe configuration template.
# IF YOU REMOVE THIS FILE: The owner loses the documented starting point for local configuration.
# DEPENDS ON: docker-compose.yml and backend/src/main/resources/application.yml.
# USED BY: The owner copies this file to the ignored .env file.
# KEY FUNCTIONS: None; replace placeholders locally before running services.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-admin-password
POSTGRES_DB=interview_prep
POSTGRES_APP_USER=interview_prep_app
POSTGRES_APP_PASSWORD=replace-with-a-local-app-password
POSTGRES_HOST_PORT=5432

DB_URL=jdbc:postgresql://127.0.0.1:5432/interview_prep
DB_USERNAME=interview_prep_app
DB_PASSWORD=replace-with-a-local-app-password
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Leave unset until you choose a compatible provider. These values are backend-only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
